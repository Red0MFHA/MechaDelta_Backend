# Prefer Postgres in production. Local demo falls back to SQLite if Postgres is unreachable.
DATABASE_URL=postgresql+psycopg://mechadelta:mechadelta@localhost:5432/mechadelta
# Set to 1 to force SQLite file under ./data/app.db (no Postgres required).
FORCE_SQLITE=1
# Point this at the simulation workspace runs/ folder for live/completed memory.
# Example: /home/YOU/mechadelta_ws/runs   or   /home/YOU/FYP/MechaDelta/runs
MECHADELTA_RUNS_ROOT=./fixtures/runs
BRIDGE_URL=http://127.0.0.1:8765
CORS_ORIGINS=http://localhost:3000
PUBLIC_API_BASE=http://localhost:8000
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_ROOM_PREFIX=mechadelta
API_HOST=0.0.0.0
API_PORT=8000
